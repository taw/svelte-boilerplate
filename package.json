{
  "name": "svelte-boilerplate",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "start": "sirv public --host 0.0.0.0",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d public"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "livereload": "^0.10.3",
    "rollup": "^4.64.5",
    "rollup-plugin-css-only": "^4.5.5",
    "rollup-plugin-svelte": "^7.2.3",
    "svelte": "^5.57.2"
  },
  "dependencies": {
    "gh-pages": "^6.3.0",
    "sirv-cli": "^3.0.1"
  }
}
